{
  "version": 6,
  "configurePresets": [
    {
      "name": "arm-gcc-debug",
      "displayName": "STM32H723 GCC Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi-gcc.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "arm-gcc-release",
      "displayName": "STM32H723 GCC Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi-gcc.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "arm-gcc-debug" },
    { "name": "release", "configurePreset": "arm-gcc-release" }
  ]
}
